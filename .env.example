VITE_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
# Managed PostHog reverse proxy subdomain (avoids ad blockers)
VITE_POSTHOG_HOST=https://relay.subash-pandey.com

# Contact form (api/contact.ts) — server-side only, set in Vercel env vars, never VITE_-prefixed.
RESEND_API_KEY=re_your_resend_api_key
# Inbox that receives contact-form messages
CONTACT_TO=you@example.com
# Optional: sender on a domain verified in Resend. Without it, Resend's test sender only delivers to your Resend account email.
CONTACT_FROM=Portfolio contact <contact@your-domain.com>

# Blog likes (api/likes.ts) — server-side only. Vercel → Storage → Upstash Redis fills in the KV_ pair.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your_upstash_token
# Optional: random string mixed into the hashed visitor IP
LIKES_SALT=any-long-random-string
